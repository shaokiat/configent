---
import BaseLayout from '@/layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const demoConfig = `client_id: gcp-platform-support
name: "Cloud Platform Support"

branding:
  logo: assets/gcp-platform-support/logo.svg
  primary_color: "#1a73e8"
  assistant_name: "DeployBot"

corpus:
  source: corpora/gcp-platform-support/
  chunking:
    chunk_size: 512
    overlap: 64

agent:
  mode: pipeline
  model: claude-haiku-4-5-20251001
  system_prompt_file: prompts/gcp-platform-support/answer.md
  max_tokens: 2048
  effort: low
  # Retrieval below this similarity is discarded before the model sees it.
  retrieval_drop_floor: 0.3
  # The best surviving hit being weaker than this forces escalation.
  escalate_below: 0.45
  # The cheap scorer's own groundedness confidence, below which we escalate.
  confidence_threshold: 0.6
  tools:
    - search_docs
    - get_document
    - create_escalation_ticket

limits:
  rate_limit_per_minute: 60
  daily_budget_usd: 2.00`;

// The three suggested questions ship in the config, ordered one per branch so a
// walkthrough covers the whole decision surface in three turns.
const questions = [
  {
    branch: 'Answered — single document',
    text: 'My Cloud Run container fails to start — what does the PORT error mean?',
  },
  {
    branch: 'Answered — synthesised across documents',
    text: "Why won't my GKE node pool scale down after I deleted the workload?",
  },
  {
    branch: 'Escalated — depends on your project',
    text: 'Can you raise my Cloud Run instance quota for europe-west1?',
  },
];

// Both trails below are the observed output of the week 1 exit gates (G1.1, G1.2),
// not illustrations. Details are shown only where the gate recorded a number.
const answeredRun = {
  question: 'My Cloud Run container fails to start — what does the PORT error mean?',
  outcome: 'answered' as const,
  steps: [
    { stage: 'Searched the documentation', detail: 'passages above the 0.30 drop floor' },
    { stage: 'Scored the evidence', detail: 'groundedness at or above the 0.60 threshold' },
    { stage: 'Answered from sources', detail: '3 citations' },
  ],
  footer: '3 step events + done · 3 citations · 7.0s',
};

const escalatedRun = {
  question: 'Can you raise my Cloud Run instance quota for europe-west1?',
  outcome: 'escalated' as const,
  steps: [
    { stage: 'Searched the documentation', detail: 'best match 0.50 — above the escalate floor' },
    { stage: 'Scored the evidence', detail: 'groundedness 0.05 — below the 0.60 threshold' },
    { stage: 'Escalated to a human', detail: 'quota_or_billing · priority high' },
    { stage: 'Filed a ticket', detail: 'PLATFORM-1043' },
  ],
  footer: '4 step events + done · $0.014 · 5.0s',
};
---

<BaseLayout
  title="Demo"
  description="Walk through the Cloud Platform Support agent — an explicit pipeline that answers from Google Cloud documentation or escalates to a filed ticket, with every stage on the record."
>

  <div class="page container">
    <div class="page-header">
      <div class="page-label">Live Demo</div>
      <h1>Watch the agent decide</h1>
      <p class="lead">
        <strong>DeployBot</strong> answers Cloud Run, GKE and IAM questions from public
        Google Cloud documentation, with citations. When a question depends on your own
        project — quota, billing, IAM policy, cluster state — it can't be answered from
        those documents, so the agent files a ticket instead. That decision is a branch
        in Python, not a choice the model makes, and every stage of it is on the record.
      </p>
    </div>

    <!-- ── Demo card ────────────────────────────────────────────── -->
    <div class="demo-hero">
      <div class="demo-left">
        <div class="demo-meta">
          <div class="meta-row">
            <span class="meta-key">Client ID</span>
            <code class="meta-val">gcp-platform-support</code>
          </div>
          <div class="meta-row">
            <span class="meta-key">Assistant</span>
            <code class="meta-val">DeployBot</code>
          </div>
          <div class="meta-row">
            <span class="meta-key">Agent mode</span>
            <code class="meta-val green">pipeline</code>
          </div>
          <div class="meta-row">
            <span class="meta-key">Model</span>
            <code class="meta-val">claude-haiku-4-5-20251001</code>
          </div>
          <div class="meta-row">
            <span class="meta-key">Corpus</span>
            <code class="meta-val">10 Google Cloud docs · CC BY 4.0</code>
          </div>
          <div class="meta-row">
            <span class="meta-key">Escalation</span>
            <code class="meta-val">HTTP POST → mock ticket service</code>
          </div>
          <div class="meta-row">
            <span class="meta-key">Embeddings</span>
            <code class="meta-val">Voyage AI voyage-3</code>
          </div>
          <div class="meta-row">
            <span class="meta-key">Custom code</span>
            <code class="meta-val dim">one config, one pipeline module</code>
          </div>
        </div>

        <div class="what-to-try">
          <div class="wtt-label">Things to try — one per branch</div>
          <ul>
            {questions.map(q => (
              <li>
                <span class="q-branch">{q.branch}</span>
                <span class="q-text">{q.text}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="run-local">
          <div class="rl-label">Run it locally</div>
          <pre class="rl-pre"><code>make dev</code></pre>
          <p class="rl-note">
            Starts Postgres, the mock ticket service, the API and the web app. The
            assistant is at <code>localhost:3000/c/gcp-platform-support</code>.
          </p>
          <a href={`${base}/docs/getting-started`} class="rl-link">
            Full setup in the quickstart
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="demo-right">
        <div class="config-panel">
          <div class="config-panel-header">
            <span class="dot r"></span>
            <span class="dot a"></span>
            <span class="dot g"></span>
            <span class="config-panel-filename">config/gcp-platform-support.yaml</span>
            <span class="config-panel-badge">full config for this demo</span>
          </div>
          <pre class="config-panel-body"><code>{demoConfig}</code></pre>
        </div>
      </div>
    </div>

    <!-- ── The two trails ──────────────────────────────────────── -->
    <section class="section">
      <h2>Two questions, two branches</h2>
      <p class="section-sub">
        Each stage emits a <code>step</code> event as it finishes, and the UI renders
        them above the reply. The trails below are the recorded output of the week 1
        exit gates, not mock-ups.
      </p>

      <div class="trail-grid">
        {[answeredRun, escalatedRun].map(run => (
          <div class:list={['trail-card', run.outcome]}>
            <div class="trail-q">{run.question}</div>
            <ol class="trail-steps">
              {run.steps.map(s => (
                <li>
                  <span class="ts-stage">{s.stage}</span>
                  <span class="ts-detail">{s.detail}</span>
                </li>
              ))}
            </ol>
            <div class="trail-footer">{run.footer}</div>
          </div>
        ))}
      </div>

      <div class="trail-note">
        <strong>Read the escalated trail closely.</strong> Retrieval scored 0.50 — above
        the 0.45 escalate floor, so the first signal passed. The second signal caught it:
        groundedness 0.05 says the retrieved passage does not contain the answer. That is
        the "found the right document, which doesn't answer the question" case, and it is
        why the guardrail reads two signals rather than one.
      </div>
    </section>

    <!-- ── What the demo shows ─────────────────────────────────── -->
    <section class="section">
      <h2>What the demo shows</h2>
      <div class="show-grid">
        <div class="show-item">
          <div class="show-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M6 3v12"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/>
              <path d="M18 9a9 9 0 0 1-9 9"/>
            </svg>
          </div>
          <div>
            <h4>The decision is a Python branch</h4>
            <p>
              Retrieval similarity and a groundedness score are compared against two
              configured thresholds. The model is never asked whether it should escalate.
            </p>
          </div>
        </div>
        <div class="show-item">
          <div class="show-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/>
              <line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/>
              <line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
            </svg>
          </div>
          <div>
            <h4>Every stage is on the record</h4>
            <p>
              Each stage commits to <code>Run.steps</code> before the next one starts, so
              the trail survives a reload — and a process death mid-run.
            </p>
          </div>
        </div>
        <div class="show-item">
          <div class="show-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
          </div>
          <div>
            <h4>The ticket is a real HTTP call</h4>
            <p>
              Escalation POSTs to a separate ticket service over the network, with an
              idempotency key. The service assigns the id, so nothing is faked in-process.
            </p>
          </div>
        </div>
        <div class="show-item">
          <div class="show-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="11" width="18" height="11" rx="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <div>
            <h4>The answering model can't escalate</h4>
            <p>
              Its request payload carries no ticket tool definition — no <code>tools</code>
              key at all. Asserted in a test, not by inspection.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Build status ─────────────────────────────────────────── -->
    <section class="section">
      <h2>What's built</h2>
      <div class="status-list">
        <div class="status-row done">
          <span class="status-mark">✓</span>
          <span class="status-week">Week 1</span>
          <span class="status-text">
            Explicit pipeline, the two-signal guardrail, a real HTTP ticket call, and the
            step trail in the UI. All four exit gates verified.
          </span>
        </div>
        <div class="status-row next">
          <span class="status-mark">○</span>
          <span class="status-week">Week 2</span>
          <span class="status-text">
            Validated schemas between stages, checkpoint and resume, and a ticket that is
            filed exactly once across a crash.
          </span>
        </div>
        <div class="status-row next">
          <span class="status-mark">○</span>
          <span class="status-week">Week 3</span>
          <span class="status-text">
            A golden set and eval runs producing decision accuracy, citation accuracy and
            $/query from logged tokens.
          </span>
        </div>
      </div>
    </section>

    <!-- ── Deploy your own ──────────────────────────────────────── -->
    <section class="section deploy-section">
      <div class="deploy-inner">
        <div>
          <h2>Point it at your own documents</h2>
          <p>
            The pipeline reads its thresholds, corpus and prompts from config. A different
            support domain is a new YAML file and a folder of documents.
          </p>
        </div>
        <a href={`${base}/docs/getting-started`} class="btn-outline">
          Quickstart guide
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </section>
  </div>

</BaseLayout>

<style>
  .page {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .page-header {
    max-width: 68ch;
    margin-bottom: 3rem;
  }

  .page-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .page-header h1 { margin-bottom: 1rem; }

  .lead {
    font-size: 1.0625rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0;
  }
  .lead strong { color: var(--text); font-weight: 600; }

  /* ── Demo hero ────────────────────────────────────────────────── */
  .demo-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 4rem;
    align-items: start;
  }

  .demo-left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .demo-meta {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
  }

  .meta-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.875rem;
  }
  .meta-row:last-child { border-bottom: none; }

  .meta-key {
    color: var(--text-muted);
    width: 110px;
    flex-shrink: 0;
  }

  .meta-val {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text);
    background: var(--bg-elevated);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }
  .meta-val.green { color: var(--green); border-color: rgba(52,211,153,0.2); background: rgba(52,211,153,0.06); }
  .meta-val.dim   { color: var(--text-faint); }

  /* ── Things to try ────────────────────────────────────────────── */
  .what-to-try {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
  }

  .wtt-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-faint);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .what-to-try ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .what-to-try li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.625rem 0.75rem;
    background: var(--bg-elevated);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }

  .q-branch {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .q-text {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* ── Run locally ──────────────────────────────────────────────── */
  .run-local {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
  }

  .rl-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-faint);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .rl-pre {
    margin: 0 0 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    color: var(--text);
    overflow-x: auto;
  }

  .rl-note {
    margin: 0 0 0.875rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .rl-note code {
    font-size: 0.8rem;
    word-break: break-all;
  }

  .rl-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }
  .rl-link:hover { text-decoration: underline; }

  /* ── Config panel ─────────────────────────────────────────────── */
  .config-panel {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    overflow: hidden;
  }

  .config-panel-header {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.75rem 1rem;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border);
  }

  .dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .dot.r { background: #ff5f57; }
  .dot.a { background: #ffbd2e; }
  .dot.g { background: #28ca41; }

  .config-panel-filename {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-left: 0.5rem;
  }

  .config-panel-badge {
    margin-left: auto;
    font-size: 0.7rem;
    color: var(--accent);
    background: var(--accent-subtle);
    border: 1px solid rgba(99,102,241,0.2);
    border-radius: 100px;
    padding: 0.15rem 0.5rem;
    white-space: nowrap;
  }

  .config-panel-body {
    margin: 0;
    padding: 1.25rem 1.5rem;
    background: transparent;
    border: none;
    border-radius: 0;
    font-size: 0.8rem;
    line-height: 1.7;
    overflow-x: auto;
    color: var(--text-muted);
  }

  /* ── Sections ─────────────────────────────────────────────────── */
  .section { margin-bottom: 4rem; }
  .section h2 { color: var(--text); margin-bottom: 0.75rem; }

  .section-sub {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 68ch;
    margin: 0 0 1.75rem;
  }

  /* ── Step trails ──────────────────────────────────────────────── */
  .trail-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .trail-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    border-top: 2px solid var(--border-accent);
    display: flex;
    flex-direction: column;
  }
  .trail-card.escalated { border-top-color: #f59e0b; }

  .trail-q {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1.5;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .trail-steps {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .trail-steps li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-left: 1.25rem;
    position: relative;
  }
  .trail-steps li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.35rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .trail-card.escalated .trail-steps li:nth-child(n+3)::before { background: #f59e0b; }
  .trail-steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 3px;
    top: 1.1rem;
    bottom: -0.75rem;
    width: 1px;
    background: var(--border);
  }

  .ts-stage {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text);
  }

  .ts-detail {
    font-family: var(--font-mono);
    font-size: 0.775rem;
    color: var(--text-muted);
  }

  .trail-footer {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    padding-top: 0.875rem;
    border-top: 1px solid var(--border);
    margin-top: auto;
  }

  .trail-note {
    margin-top: 1.25rem;
    padding: 1rem 1.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent);
    border-radius: var(--radius);
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--text-muted);
  }
  .trail-note strong { color: var(--text); }

  /* ── What the demo shows ──────────────────────────────────────── */
  .show-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .show-item {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    align-items: flex-start;
  }

  .show-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-subtle);
    border: 1px solid rgba(99,102,241,0.2);
    border-radius: var(--radius);
    color: var(--accent);
  }

  .show-item h4 { color: var(--text); margin-bottom: 0.375rem; }
  .show-item p  { font-size: 0.875rem; color: var(--text-muted); line-height: 1.6; margin: 0; }

  /* ── Build status ─────────────────────────────────────────────── */
  .status-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .status-row {
    display: grid;
    grid-template-columns: 20px 72px 1fr;
    gap: 0.875rem;
    align-items: baseline;
    padding: 0.875rem 1.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .status-mark { font-size: 0.9rem; }
  .status-row.done .status-mark { color: var(--green); }
  .status-row.next .status-mark { color: var(--text-faint); }

  .status-week {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text);
  }
  .status-row.next .status-week { color: var(--text-muted); }

  .status-text {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
