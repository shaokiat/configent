---
// Architecture diagram for the support graph: three tiers, the two decision points evaluated
// in Python, and the durable step trail. Fills are CSS variables so light/dark theme works.
---

<div class="diagram-wrap">
  <svg
    class="arch-svg"
    viewBox="0 0 1000 700"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Configent support graph: a config file selects the graph engine. Level 1 retrieves passages from pgvector and grades them; a Python function answers, replies conversationally to a greeting, or falls through. Level 2 rewrites the question, runs keyword and semantic search fused by rank, and regrades; a second Python function answers or falls through. Level 3 drafts a ticket and pauses until the user confirms, then POSTs it to the ticket service. Every node commits a step to the run's trail, and LangGraph checkpoints after every node."
  >
    <defs>
      <marker id="arrow" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" fill="#6366f1"/>
      </marker>
      <marker id="arrow-dim" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
        <polygon class="stroke-dim-fill" points="0 0, 8 3, 0 6"/>
      </marker>
      <marker id="arrow-amber" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" fill="#f59e0b"/>
      </marker>
      <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3" result="blur"/>
        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
    </defs>

    <!-- ── Config file (left) ─────────────────────────────────── -->
    <text x="20" y="220" class="label-xs text-faint">1. Author config</text>
    <g transform="translate(20, 230)">
      <rect class="bg-surface stroke-accent" width="170" height="190" rx="10" stroke-width="1.5"/>
      <text x="12" y="28"  class="mono-sm text-faint">client_id:</text>
      <text x="20" y="43"  class="mono-sm y-key">gcp-platform-support</text>
      <text x="12" y="64"  class="mono-sm text-faint">agent:</text>
      <text x="20" y="79"  class="mono-sm y-str">model: haiku-4-5</text>
      <text x="20" y="97"  class="mono-sm text-faint">escalate_below:</text>
      <text x="28" y="112" class="mono-sm y-str">0.45</text>
      <text x="20" y="130" class="mono-sm text-faint">corrective:</text>
      <text x="28" y="145" class="mono-sm y-str">enabled: true</text>
      <text x="85" y="176" text-anchor="middle" class="mono-sm-bold y-key">config.yaml</text>
    </g>
    <line x1="192" y1="325" x2="208" y2="325" stroke="#6366f1" stroke-width="1.5" marker-end="url(#arrow)"/>

    <!-- ── Engine outer box ───────────────────────────────────── -->
    <rect class="bg-engine stroke-dim" x="210" y="30" width="600" height="626" rx="12" stroke-width="1.5" stroke-dasharray="4 3"/>
    <text x="510" y="52" text-anchor="middle" class="label-xs text-faint letter-wide">CONFIGENT SUPPORT GRAPH · LANGGRAPH</text>

    <!-- ── Tier labels (right of the centre column) ───────────── -->
    <text x="696" y="162" class="label-xs text-muted letter-wide">LEVEL 1</text>
    <text x="696" y="176" class="label-xs text-faint">RAG</text>
    <text x="696" y="306" class="label-xs text-muted letter-wide">LEVEL 2</text>
    <text x="696" y="320" class="label-xs text-faint">corrective RAG</text>
    <text x="696" y="514" class="label-xs text-muted letter-wide">LEVEL 3</text>
    <text x="696" y="528" class="label-xs text-faint">human</text>

    <!-- ── Level 1 ────────────────────────────────────────────── -->
    <rect class="bg-surface stroke-dim" x="400" y="84" width="280" height="44" rx="8" stroke-width="1"/>
    <text x="540" y="103" text-anchor="middle" class="mono-sm-bold y-key">retrieve</text>
    <text x="540" y="120" text-anchor="middle" class="label-xs text-faint">embed → pgvector · drop below 0.30</text>

    <line x1="540" y1="128" x2="540" y2="142" class="stroke-dim-line" stroke-width="1.5" marker-end="url(#arrow-dim)"/>

    <rect class="bg-surface stroke-dim" x="400" y="144" width="280" height="44" rx="8" stroke-width="1"/>
    <text x="540" y="163" text-anchor="middle" class="mono-sm-bold y-key">grade</text>
    <text x="540" y="180" text-anchor="middle" class="label-xs text-faint">cheap model · groundedness + kind</text>

    <line x1="540" y1="188" x2="540" y2="202" class="stroke-dim-line" stroke-width="1.5" marker-end="url(#arrow-dim)"/>

    <rect class="bg-surface stroke-accent" x="380" y="204" width="320" height="48" rx="8" stroke-width="1.5" filter="url(#glow)"/>
    <text x="540" y="224" text-anchor="middle" class="label-sm text-primary" font-weight="600">decide_level1 · plain Python</text>
    <text x="540" y="242" text-anchor="middle" class="mono-xs text-accent">similarity ≥ 0.45 and groundedness ≥ 0.60</text>

    <!-- greeting → converse -->
    <line x1="700" y1="228" x2="712" y2="228" class="stroke-dim-line" stroke-width="1.5" marker-end="url(#arrow-dim)"/>
    <rect class="bg-raised stroke-dim" x="714" y="206" width="86" height="44" rx="8" stroke-width="1"/>
    <text x="757" y="226" text-anchor="middle" class="mono-sm-bold y-key">converse</text>
    <text x="757" y="242" text-anchor="middle" class="label-xs text-faint">no ticket</text>
    <text x="757" y="266" text-anchor="middle" class="label-xs text-muted">greeting</text>

    <!-- pass → answer -->
    <polyline points="380,228 301,228 301,298" fill="none" stroke="#6366f1" stroke-width="1.5" marker-end="url(#arrow)"/>
    <text x="340" y="222" text-anchor="middle" class="label-xs text-green">pass</text>

    <!-- falls short → Level 2 -->
    <line x1="540" y1="252" x2="540" y2="290" stroke="#f59e0b" stroke-width="1.5" marker-end="url(#arrow-amber)"/>
    <text x="548" y="276" class="label-xs text-amber">falls short</text>

    <!-- ── Level 2 ────────────────────────────────────────────── -->
    <rect class="bg-surface stroke-dim" x="400" y="292" width="280" height="44" rx="8" stroke-width="1"/>
    <text x="540" y="311" text-anchor="middle" class="mono-sm-bold y-key">rewrite</text>
    <text x="540" y="328" text-anchor="middle" class="label-xs text-faint">semantic variants + exact keywords</text>

    <line x1="540" y1="336" x2="540" y2="350" class="stroke-dim-line" stroke-width="1.5" marker-end="url(#arrow-dim)"/>

    <rect class="bg-surface stroke-dim" x="400" y="352" width="280" height="44" rx="8" stroke-width="1"/>
    <text x="540" y="371" text-anchor="middle" class="mono-sm-bold y-key">hybrid_retrieve</text>
    <text x="540" y="388" text-anchor="middle" class="label-xs text-faint">pgvector + Postgres full-text · rank fusion</text>

    <line x1="540" y1="396" x2="540" y2="410" class="stroke-dim-line" stroke-width="1.5" marker-end="url(#arrow-dim)"/>

    <rect class="bg-surface stroke-accent" x="380" y="412" width="320" height="48" rx="8" stroke-width="1.5" filter="url(#glow)"/>
    <text x="540" y="432" text-anchor="middle" class="label-sm text-primary" font-weight="600">regrade → decide_level2 · plain Python</text>
    <text x="540" y="450" text-anchor="middle" class="mono-xs text-accent">groundedness ≥ 0.60</text>

    <!-- pass → answer -->
    <polyline points="380,436 301,436 301,374" fill="none" stroke="#6366f1" stroke-width="1.5" marker-end="url(#arrow)"/>
    <text x="340" y="430" text-anchor="middle" class="label-xs text-green">pass</text>

    <!-- falls short → Level 3 -->
    <line x1="540" y1="460" x2="540" y2="498" stroke="#f59e0b" stroke-width="1.5" marker-end="url(#arrow-amber)"/>
    <text x="548" y="484" class="label-xs text-amber">falls short</text>

    <!-- ── answer (shared by both levels) ─────────────────────── -->
    <rect class="bg-output stroke-green" x="226" y="300" width="150" height="72" rx="8" stroke-width="1"/>
    <text x="301" y="320" text-anchor="middle" class="mono-sm-bold y-key">answer</text>
    <text x="301" y="338" text-anchor="middle" class="label-xs text-green">cited, streamed</text>
    <text x="301" y="352" text-anchor="middle" class="label-xs text-faint">search_result blocks</text>
    <text x="301" y="366" text-anchor="middle" class="label-xs text-faint">no tools in the request</text>

    <!-- ── Level 3 ────────────────────────────────────────────── -->
    <rect class="bg-raised stroke-dim" x="400" y="500" width="280" height="44" rx="8" stroke-width="1"/>
    <text x="540" y="519" text-anchor="middle" class="mono-sm-bold y-str">escalate</text>
    <text x="540" y="536" text-anchor="middle" class="label-xs text-faint">draft the ticket · offer it</text>

    <line x1="540" y1="544" x2="540" y2="558" stroke="#f59e0b" stroke-width="1.5" marker-end="url(#arrow-amber)"/>

    <rect class="bg-surface stroke-amber" x="400" y="560" width="280" height="44" rx="8" stroke-width="1"/>
    <text x="540" y="579" text-anchor="middle" class="mono-sm-bold y-str">ticket</text>
    <text x="540" y="596" text-anchor="middle" class="label-xs text-faint">interrupt() · files after the user confirms</text>

    <!-- ── Durable step trail ─────────────────────────────────── -->
    <rect class="bg-raised stroke-dim" x="226" y="618" width="568" height="26" rx="6" stroke-width="1" stroke-dasharray="3 2"/>
    <text x="510" y="635" text-anchor="middle" class="label-xs text-muted">
      Run.steps · one entry per node, committed before the next · a LangGraph checkpoint after every node
    </text>

    <!-- ── Corpus (top right) ─────────────────────────────────── -->
    <g transform="translate(830, 84)">
      <rect class="bg-surface stroke-dim" width="150" height="82" rx="8" stroke-width="1"/>
      <text x="75" y="26" text-anchor="middle" class="label-sm text-muted">Corpus</text>
      <text x="75" y="44" text-anchor="middle" class="mono-xs text-faint">Google Cloud docs</text>
      <text x="75" y="60" text-anchor="middle" class="mono-xs text-faint">vectors + tsvector</text>
      <text x="75" y="75" text-anchor="middle" class="label-xs text-faint">Postgres · per client_id</text>
    </g>
    <line x1="828" y1="106" x2="684" y2="106" class="stroke-dim-line" stroke-width="1.5" marker-end="url(#arrow-dim)"/>
    <polyline points="905,168 905,374 684,374" fill="none" class="stroke-dim-line" stroke-width="1.5" marker-end="url(#arrow-dim)"/>

    <!-- ── Ticket service (bottom right) ──────────────────────── -->
    <g transform="translate(830, 550)">
      <rect class="bg-surface stroke-amber" width="150" height="64" rx="8" stroke-width="1"/>
      <text x="75" y="24" text-anchor="middle" class="label-sm text-muted">Ticket service</text>
      <text x="75" y="42" text-anchor="middle" class="mono-xs text-faint">separate process</text>
      <text x="75" y="57" text-anchor="middle" class="label-xs text-faint">assigns the ticket id</text>
    </g>
    <line x1="680" y1="582" x2="826" y2="582" stroke="#f59e0b" stroke-width="1.5" marker-end="url(#arrow-amber)"/>

    <!-- ── Caption ────────────────────────────────────────────── -->
    <text x="210" y="684" class="label-xs text-accent">
      Every route is a Python function · LangGraph owns checkpoints and the pause · nothing is filed until the user confirms
    </text>
  </svg>
</div>

<style>
  /* ── Wrapper ─────────────────────────────────────────────────── */
  .diagram-wrap {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    padding: 1.5rem;
  }

  .arch-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── Fill classes ────────────────────────────────────────────── */
  .bg-engine  { fill: var(--svg-bg-engine); }
  .bg-surface { fill: var(--svg-bg-surface); }
  .bg-raised  { fill: var(--svg-bg-raised); }
  .bg-output  { fill: var(--svg-bg-output); }

  /* ── Stroke classes ──────────────────────────────────────────── */
  .stroke-accent      { stroke: #6366f1; }
  .stroke-dim         { stroke: var(--svg-stroke); }
  .stroke-green       { stroke: var(--svg-green-text); }
  .stroke-amber       { stroke: #f59e0b; }

  /* Lines and marker fill */
  .stroke-dim-line { stroke: var(--svg-stroke); }
  .stroke-dim-fill { fill: var(--svg-stroke); }

  /* ── Text classes ────────────────────────────────────────────── */
  .text-primary { fill: var(--svg-text); }
  .text-muted   { fill: var(--svg-text-muted); }
  .text-faint   { fill: var(--svg-text-faint); }
  .text-accent  { fill: #6366f1; }
  .text-green   { fill: var(--svg-green-text); }
  .text-amber   { fill: #f59e0b; }

  /* YAML token colours (reuse site tokens) */
  .y-key  { fill: var(--y-key); }
  .y-str  { fill: var(--y-str); }
  .y-bool { fill: var(--y-bool); }

  /* ── Font helpers ────────────────────────────────────────────── */
  .mono-sm      { font-family: monospace; font-size: 10px; }
  .mono-sm-bold { font-family: monospace; font-size: 12px; font-weight: 600; }
  .mono-xs      { font-family: monospace; font-size: 10px; }
  .label-sm     { font-family: system-ui, sans-serif; font-size: 12px; }
  .label-xs     { font-family: system-ui, sans-serif; font-size: 10px; }
  .letter-wide  { letter-spacing: 0.08em; }
</style>
