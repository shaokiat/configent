---
// An Archify diagram, shown as a static SVG that fits the column; a click opens the
// interactive page. Source: docs/diagrams/<name>.archify.json. Regenerate with
// `make docs-archify`, which renders public/diagrams/<name>.html and exports
// <name>-light.svg and <name>-dark.svg from it.
interface Props {
  name: string;
  title: string;
}
const { name, title } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/diagrams/${name}`;
---

<figure class="diagram">
  <a href={`${base}.html`} target="_blank" rel="noopener" aria-label={`${title}, interactive version`}>
    <img class="light" src={`${base}-light.svg`} alt={title} loading="lazy" />
    <img class="dark" src={`${base}-dark.svg`} alt={title} loading="lazy" />
  </a>
  <figcaption>
    {title} · <a href={`${base}.html`} target="_blank" rel="noopener">open interactive</a>
  </figcaption>
</figure>

<style>
  .diagram { margin: 2rem 0; }
  img {
    width: 100%;
    max-width: 960px;
    height: auto;
    margin: 0 auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .light { display: none; }
  :global([data-theme="light"]) .light { display: block; }
  :global([data-theme="light"]) .dark { display: none; }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
