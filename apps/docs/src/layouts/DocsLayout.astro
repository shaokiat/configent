---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
}

const { title, description, headings = [] } = Astro.props;

// h2/h3 only — h4 and below are too fine-grained for a rail this narrow. One lone
// heading is not a table of contents, so the rail is dropped entirely below two.
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname;

const allDocs = await getCollection('docs');
const sorted = allDocs
  .filter(doc => doc.data.group)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

// Group docs, ordering groups by the lowest `order` value in each group
const groupMap = new Map<string, { minOrder: number; links: { href: string; label: string }[] }>();
for (const doc of sorted) {
  const g = doc.data.group!;
  if (!groupMap.has(g)) groupMap.set(g, { minOrder: doc.data.order ?? 99, links: [] });
  groupMap.get(g)!.links.push({ href: `${base}/docs/${doc.slug}`, label: doc.data.title });
}
const sidebarLinks = [...groupMap.entries()]
  .sort((a, b) => a[1].minOrder - b[1].minOrder)
  .map(([group, { links }]) => ({ group, links }));

function isActive(href: string) {
  return currentPath === href || currentPath === href + '/';
}
---

<BaseLayout title={title} description={description}>
  <div class="docs-layout container">
    <aside class="sidebar" aria-label="Documentation navigation">
      <nav>
        {sidebarLinks.map(group => (
          <div class="sidebar-group">
            <div class="sidebar-group-label">{group.group}</div>
            {group.links.map(link => (
              <a
                href={link.href}
                class:list={['sidebar-link', { active: isActive(link.href) }]}
              >
                {link.label}
              </a>
            ))}
          </div>
        ))}
      </nav>
    </aside>

    <article class="docs-content">
      <slot />
    </article>

    {toc.length > 1 && (
      <aside class="toc" aria-label="On this page">
        <div class="toc-label">On this page</div>
        <nav>
          {toc.map(h => (
            <a href={`#${h.slug}`} class:list={['toc-link', { sub: h.depth === 3 }]}>
              {h.text}
            </a>
          ))}
        </nav>
      </aside>
    )}
  </div>
</BaseLayout>

<style>
  .docs-layout {
    display: grid;
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr) var(--toc-width);
    gap: 2.5rem;
    padding-top: 3rem;
    padding-bottom: 3rem;
    align-items: start;
    /* Wider than the default .container: three columns don't fit in 1200px. */
    max-width: 1400px;
  }

  /* Pages with no table of contents keep the two-column layout. */
  .docs-layout:not(:has(.toc)) {
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    max-width: 1200px;
  }

  .sidebar {
    position: sticky;
    top: calc(var(--nav-height) + 1.5rem);
    max-height: calc(100vh - var(--nav-height) - 3rem);
    overflow-y: auto;
  }

  .sidebar-group {
    margin-bottom: 1.25rem;
  }

  .sidebar-group-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-faint);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0 0.75rem;
    margin-bottom: 0.2rem;
  }

  .sidebar-link {
    display: block;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    color: var(--text-muted);
    transition: color 0.15s, background 0.15s;
    text-decoration: none;
  }
  .sidebar-link:hover {
    color: var(--text);
    background: var(--bg-elevated);
    text-decoration: none;
  }
  .sidebar-link.active {
    color: var(--accent);
    background: var(--accent-subtle);
  }

  /* ── Right rail: table of contents ────────────────────────────── */
  .toc {
    position: sticky;
    top: calc(var(--nav-height) + 1.5rem);
    max-height: calc(100vh - var(--nav-height) - 3rem);
    overflow-y: auto;
    border-left: 1px solid var(--border);
    padding-left: 1rem;
  }

  .toc-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-faint);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .toc-link {
    display: block;
    padding: 0.2rem 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .toc-link.sub {
    padding-left: 0.75rem;
    font-size: 0.78125rem;
    color: var(--text-faint);
  }
  .toc-link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  /* ── Docs content typography ──────────────────────────────────── */
  .docs-content {
    max-width: var(--content-max);
    min-width: 0;
  }

  .docs-content :global(h1) {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .docs-content :global(h2) {
    margin-top: 3rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }

  .docs-content :global(h3) {
    margin-top: 2rem;
    color: var(--text);
  }

  /* Jumping to a TOC anchor otherwise lands the heading under the fixed nav. */
  .docs-content :global(h2),
  .docs-content :global(h3) {
    scroll-margin-top: calc(var(--nav-height) + 1rem);
  }

  .docs-content :global(p) {
    line-height: 1.75;
    color: var(--text-muted);
  }

  .docs-content :global(ul),
  .docs-content :global(ol) {
    padding-left: 1.5rem;
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .docs-content :global(li) { margin-bottom: 0.25rem; }

  .docs-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    margin: 1.5rem 0;
  }

  .docs-content :global(th) {
    text-align: left;
    padding: 0.625rem 1rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--text);
    font-weight: 500;
    font-size: 0.8rem;
  }

  .docs-content :global(td) {
    padding: 0.625rem 1rem;
    border: 1px solid var(--border);
    color: var(--text-muted);
    vertical-align: top;
  }

  .docs-content :global(tr:hover td) {
    background: var(--bg-surface);
  }

  .docs-content :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: 0.75rem 1.25rem;
    margin: 1.5rem 0;
    background: var(--accent-subtle);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .docs-content :global(.lead) {
    font-size: 1.125rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  /* Not enough width for three columns — the left nav is the one that matters. */
  @media (max-width: 1180px) {
    .toc { display: none; }
    .docs-layout,
    .docs-layout:not(:has(.toc)) {
      grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    }
  }

  @media (max-width: 768px) {
    .docs-layout,
    .docs-layout:not(:has(.toc)) {
      grid-template-columns: 1fr;
    }
    .sidebar {
      position: static;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1.5rem;
      margin-bottom: 1.5rem;
    }
  }
</style>
