 "cards": [
  {
   "dot": "amber",
   "title": "Consent",
   "items": [
    "Nothing is filed in request 1",
    "The draft stays in the checkpoint; the client cannot edit it"
   ]
  },
  {
   "dot": "emerald",
   "title": "Exactly once",
   "items": [
    "A second click finds ticket_id in the checkpoint: already_filed",
    "A racing retry reuses the same Idempotency-Key"
   ]
  },
  {
   "dot": "violet",
   "title": "Why two nodes",
   "items": [
    "interrupt() re-runs its node on resume",
    "So escalate drafts, and ticket only waits and files"
   ]
  }
 ]
