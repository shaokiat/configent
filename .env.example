# Copy this file to .env and fill in your keys before running docker compose.

# Every model call goes through OpenRouter (D14)
OPENROUTER_API_KEY=sk-or-...
VOYAGE_API_KEY=pa-...

# Used locally (docker-compose overrides this to point at the db service)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/configent

# Mock ticket service the escalation path posts to (docker-compose overrides the host)
TICKET_API_URL=http://localhost:9000

# Set to 1 to reload client YAML configs on every API request (dev only)
DEV_CONFIG_RELOAD=0

# Set to 1 to run integration tests that hit the real model API (OpenRouter)
RUN_INTEGRATION=0
